{
  "name": "multi-model-review",
  "version": "0.2.2",
  "description": "A faithful port of oh-my-pi's /review command onto pi — verbatim upstream prompts, diff logic and heuristics — extended so every shard of the diff is reviewed by several different model families, which then cross-check each other.",
  "license": "MIT",
  "author": "Scott Meyer",
  "type": "module",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "code-review",
    "multi-model",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scott-Meyer/multi-model-review.git"
  },
  "bugs": {
    "url": "https://github.com/Scott-Meyer/multi-model-review/issues"
  },
  "homepage": "https://github.com/Scott-Meyer/multi-model-review#readme",
  "files": [
    "src",
    "vendor",
    "agents",
    "UPSTREAM",
    "PROVENANCE.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node --import jiti/register scripts/handler-test.mjs",
    "check:upstream": "bash scripts/check-upstream-drift.sh"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
